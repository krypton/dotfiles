# Keep in mind that this file is stowed as a global gitignore file, so it will be used for all git repositories on your system.
.DS_Store
.config/lazygit/state.yml
.zcompdump*
.zsh_history*

# systemd --user generated state (enable-time symlink dirs, app-generated units)
.config/linux/systemd/user/*.target.wants/
.config/linux/systemd/user/openlogi-agent.service
