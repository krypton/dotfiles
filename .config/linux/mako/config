background-color=#222436
text-color=#c8d3f5
border-color=#86e1fc
border-radius=8
border-size=2
width=350
height=100
padding=10
margin=10
font=JetBrainsMono Nerd Font 11
default-timeout=5000

# Left-click still opens the app (invoke-default-action, mako's default).
# Right-click dismisses without focusing anything (also mako's default).
# Middle-click clears the whole stack, handy for the same reason.
on-button-middle=dismiss-all

[urgency=high]
border-color=#ff757f
# Was 0 (never expires) - critical notifications used to pile up forever.
# Give them a longer TTL instead so they still auto-clear.
default-timeout=15000
